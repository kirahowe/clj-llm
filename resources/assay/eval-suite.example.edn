;; Example eval suite. Copy to evals/suite.edn (conventionally) and run
;; with `bb eval` or (eval/run config "evals/suite.edn"). Suites are read
;; with the same aero reader as config files, so #env/#or/#profile work
;; here too.
#:assay{;; What to test. :assay/input is a prompt; use :assay/messages for
        ;; full conversations (e.g. records collected via
        ;; :assay/on-interaction). Unqualified keys on a case are yours —
        ;; custom scorers can read them.
        :cases
        [#:assay{:id :capital-of-france
                 :input "What is the capital of France? Answer with just the city name."
                 :expected "Paris"}
         #:assay{:id :arithmetic
                 :input "What is 17 * 23? Reply with only the number."
                 :expected "391"}
         #:assay{:id :summarize
                 :input "Summarize in one sentence: The mitochondria is the powerhouse of the cell, converting nutrients into ATP through cellular respiration."
                 :expected "mitochondria"}]

        ;; What to compare — each variant is a bundle of request settings.
        ;; Benchmark a model change, a prompt change, or both.
        :variants
        [#:assay{:id :baseline :model :smart}
         #:assay{:id :fast :model :fast}
         #:assay{:id :terse :model :smart :system "Answer with the minimum number of words."}]

        ;; How to score. Built-ins: :exact-match, :includes, :matches. A
        ;; qualified symbol names a scorer fn in your code. For model-graded
        ;; scoring, call eval/run from code and add
        ;; (eval/llm-judge {:model :smart :criteria "..."}) to the scorers.
        :scorers [:includes]

        ;; Optional: what a case×variant actually runs. Defaults to a single
        ;; assay.core/generate call; point it at a fn of
        ;; {:keys [config case variant]} to eval a whole system (RAG
        ;; pipeline, agent, handler) instead of a raw LLM call.
        ;; :task my.app.evals/run-pipeline

        ;; Optional: minimum mean score per scorer — makes `bb eval` exit
        ;; non-zero when quality regresses, so a suite can gate CI.
        :thresholds {:includes 0.9}}
