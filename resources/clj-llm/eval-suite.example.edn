;; Example eval suite. Copy to evals/suite.edn (conventionally) and run
;; with `bb eval` or (eval/run config "evals/suite.edn"). Suites are read
;; with the same aero reader as config files, so #env/#or/#profile work
;; here too.
{;; What to test. :input is a prompt; use :messages for full
 ;; conversations (e.g. records collected via :on-interaction).
 :cases
 [{:id :capital-of-france
   :input "What is the capital of France? Answer with just the city name."
   :expected "Paris"}
  {:id :arithmetic
   :input "What is 17 * 23? Reply with only the number."
   :expected "391"}
  {:id :summarize
   :input "Summarize in one sentence: The mitochondria is the powerhouse of the cell, converting nutrients into ATP through cellular respiration."
   :expected "mitochondria"}]

 ;; What to compare — each variant is a bundle of request settings.
 ;; Benchmark a model change, a prompt change, or both.
 :variants
 [{:id :baseline :model :smart}
  {:id :fast :model :fast}
  {:id :terse :model :smart :system "Answer with the minimum number of words."}]

 ;; How to score. Built-ins: :exact-match, :includes, :matches. For
 ;; model-graded scoring, call eval/run from code and add
 ;; (eval/llm-judge {:model :smart :criteria "..."}) to :scorers.
 :scorers [:includes]}
