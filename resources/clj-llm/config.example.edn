;; Example clj-llm configuration. Copy this to llm.edn and load it with
;; (llm/read-config "llm.edn"). It expects Ollama to be running locally.
;;
;; Config is read with aero, so #env, #or, #profile, #include, and #ref are
;; available. Set OLLAMA_HOST or OLLAMA_MODEL to override the defaults below.
;;
;; Keys defined by clj-llm use the :llm namespace. Unqualified provider keys
;; such as :base-url belong to the selected adapter. Optional
;; :llm/capabilities booleans override that adapter's feature report.
#:llm{:providers
      {:ollama {:llm/adapter :ollama
                :base-url #or [#env OLLAMA_HOST
                               "http://localhost:11434"]}}

      ;; Application code refers to aliases instead of model ids.
      :models
      {:default #:llm{:provider :ollama
                      :model #or [#env OLLAMA_MODEL "llama3.2"]}
       :fast #:llm{:provider :ollama :model "qwen3:8b"}
       :embeddings #:llm{:provider :ollama :model "nomic-embed-text"}}

      ;; :llm/on-interaction may be set from code to collect completed calls.
      :defaults
      #:llm{:model :default
            :embedding-model :embeddings
            :max-tokens #profile {:dev 1024 :default 4096}}}
